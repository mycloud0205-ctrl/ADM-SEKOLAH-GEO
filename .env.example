# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side override for Admin login password.
# If left empty, the first user can claim the Admin password via the UI setup form.
ADMIN_PASSCODE=

# MYSQL_*: Online MySQL Database connection credentials (server-side only).
# Configure these in the Secrets panel before deploying or syncing to remote MySQL.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional online Supabase project credentials
# for syncing school records to Supabase PostgreSQL in addition to the local real-time DB.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HOSTING TERPISAH (Opsional):
# Jika folder dist/ di-upload ke hosting statis/PHP dan backend Node.js / api.php berjalan di URL lain
# (misalnya http://aseptea.my.id/demo/api.php atau https://api.domainanda.com),
# isi VITE_API_BASE_URL sebelum menjalankan "npm run build", atau atur langsung dari UI aplikasi.
VITE_API_BASE_URL=
CORS_ORIGIN=*

