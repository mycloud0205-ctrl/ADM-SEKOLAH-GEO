rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pengaturan/{id} {
      allow read, write: if true;
    }
    match /siswa/{id} {
      allow read, write: if true;
    }
    match /users/{id} {
      allow read, write: if true;
    }
    match /kehadiran_siswa/{id} {
      allow read, write: if true;
    }
    match /kehadiran_pegawai/{id} {
      allow read, write: if true;
    }
    match /jurnal_harian/{id} {
      allow read, write: if true;
    }
    match /kalender_pendidikan/{id} {
      allow read, write: if true;
    }
    match /data_jurusan/{id} {
      allow read, write: if true;
    }
    match /nilai_siswa/{id} {
      allow read, write: if true;
    }
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
